# ---- core ----
APP_ENV=development            # development | production
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# ---- database ----
# local  : postgres://plot:plot@localhost:5432/plotting?sslmode=disable
# neon   : postgres://USER:PASS@ep-xxx.ap-southeast-1.aws.neon.tech/plotting?sslmode=require
DATABASE_URL=postgres://plot:plot@localhost:5432/plotting?sslmode=disable

# ---- auth ----
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-48-byte-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ---- object storage (Cloudflare R2, S3-compatible) ----
# local dev points at MinIO from docker-compose
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=plotting-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/plotting-media

# ---- email (Resend free tier: 3000/month) ----
RESEND_API_KEY=
MAIL_FROM=no-reply@yourdomain.in
