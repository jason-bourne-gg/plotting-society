# Baked into the bundle at build time by Vite.
#
# This lives in the repo rather than in a dashboard build variable because it is
# not a secret — it is a public URL the browser has to know anyway — and because
# a build that silently forgets it produces a site where every request 404s
# against the front end's own origin, with nothing in the console to say why.
#
# Change it here and redeploy; there is no runtime override.
VITE_API_BASE_URL=https://plotting-society-api.onrender.com
